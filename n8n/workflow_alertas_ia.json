    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// El item 4 trae varias métricas probe_success juntas — buscamos la de nginx-web específicamente\nconst probes = items[4].json.data.result || [];\nconst webProbe = probes.find(p => p.metric.servicio === \"nginx-web\");\n\n// Los items 5,6,7 son conteos de Loki — si no hay resultado, es 0 eventos\nfunction countLoki(item) {\n  const r = item.json.data.result;\n  if (!r || r.length === 0) return 0;\n  return parseInt(r[0].value[1], 10);\n}\n\nreturn [{\n  json: {\n    ram: items[0].json.data.result[0]?.value[1] ?? null,\n    disco: items[1].json.data.result[0]?.value[1] ?? null,\n    red_mbps: items[2].json.data.result[0]?.value[1] ?? null,\n    cpu: items[3].json.data.result[0]?.value[1] ?? null,\n    web_up: webProbe ? webProbe.value[1] : \"0\",\n    nginx_errores_5min: countLoki(items[5]),\n    mysql_slow_queries_5min: countLoki(items[6]),\n    ssh_intentos_fallidos_5min: countLoki(items[7]),\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        -288
      ],
      "id": "b5d37e2b-d165-4157-b41d-6569c920d87b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{PEGAR_SU_GROQ_API_KEY_AQUI}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "=json",
        "bodyParameters": {
          "parameters": [
            {}
          ]
        },
        "jsonBody": "={\n  \"model\": \"llama-3.1-8b-instant\",\n  \"temperature\": 0.2,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres un ingeniero de soporte de TI para NutriAlianza S.A., una planta de nutrición animal. Vas a recibir métricas de servidor Y actividad de logs (errores web, consultas lentas de base de datos, intentos de acceso SSH). Tu trabajo es CORRELACIONAR ambas fuentes, no analizarlas por separado. Debes responder ÚNICAMENTE con un objeto JSON válido, sin texto adicional, sin markdown, sin backticks, siguiendo EXACTAMENTE este esquema: {\\\"severidad\\\": \\\"baja|media|critica\\\", \\\"resumen\\\": \\\"string\\\", \\\"causa_probable\\\": \\\"string\\\", \\\"recomendacion\\\": \\\"string\\\"}. Si varias señales apuntan al mismo problema (por ejemplo, alto CPU junto con muchos errores Nginx), explícalo como una sola causa raíz, no como eventos separados. Si no hay ninguna anomalía real, responde con severidad baja.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Métricas actuales del servidor NutriAlianza: CPU {{ $json.cpu }}%, RAM {{ $json.ram }}%, Disco {{ $json.disco }}%, Red {{ $json.red_mbps }} Mbps, Estado del servicio web (1=activo 0=caído): {{ $json.web_up }}. Actividad de logs en los últimos 5 minutos: {{ $json.nginx_errores_5min }} errores en Nginx, {{ $json.mysql_slow_queries_5min }} consultas lentas en MySQL, {{ $json.ssh_intentos_fallidos_5min }} intentos de contraseña SSH fallidos. Analiza correlacionando todas estas señales y da tu diagnóstico.\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
