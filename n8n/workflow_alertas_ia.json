    {
      "parameters": {
        "jsCode": "const respuesta = JSON.parse($input.first().json.choices[0].message.content);\n\nconst emojis = { baja: \"🟢\", media: \"🟡\", critica: \"🔴\" };\n\nconst texto = `${emojis[respuesta.severidad] || \"⚪\"} ALERTA ${respuesta.severidad.toUpperCase()} - NutriAlianza S.A.\n\nResumen: ${respuesta.resumen}\nCausa probable: ${respuesta.causa_probable}\nRecomendación: ${respuesta.recomendacion}`;\n\nreturn [{ json: { texto } }];"
      },
